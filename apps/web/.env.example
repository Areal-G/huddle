# A secret key used to encrypt user sessions (required, at least 32 characters)
# Generate a random secret key using: openssl rand -hex 32
SECRET_PASSWORD=

# The base url where this instance is accessible, including the scheme.
# Example: https://example.com
NEXT_PUBLIC_BASE_URL=https://web.huddle.test

# Optional. Base url for links handed to participants (poll invites, event
# pages) when they should live on another domain that redirects here.
# Defaults to NEXT_PUBLIC_BASE_URL.
# NEXT_PUBLIC_SHORT_BASE_URL=https://example.com

# A connection string to your Postgres database
DATABASE_URL=postgres://postgres:postgres@localhost:5450/huddle

# Required to be able to send emails
SUPPORT_EMAIL=support@huddle.example
# Optional sender address and name for outgoing email (defaults: SUPPORT_EMAIL, "Huddle")
# NOREPLY_EMAIL=noreply@huddle.example
# NOREPLY_EMAIL_NAME=Huddle

# Email provider: smtp (default) or ses
# EMAIL_PROVIDER=smtp

# SMTP settings for sending emails
# Defaults below are configured for the local Mailpit instance (see docker-compose.dev.yml)
SMTP_HOST=0.0.0.0
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PWD=
# Set to false to accept self-signed certificates (default: true)
# SMTP_REJECT_UNAUTHORIZED=true
# Hostname to verify the certificate against when SMTP_HOST is an IP address
# SMTP_TLS_SERVERNAME=
# Deprecated, no longer have any effect: SMTP_TLS_ENABLED, SMTP_DEBUG
# SMTP_TLS_ENABLED=
# SMTP_DEBUG=

# Amazon SES (when EMAIL_PROVIDER=ses)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# Where SES sends bounce and complaint reports (must be on a verified SES identity)
# SES_FEEDBACK_EMAIL=

# Object Storage (S3) (optional)
# Defaults below are configured for the local Garage instance (see docker-compose.dev.yml)
S3_BUCKET_NAME=huddle
S3_ENDPOINT=http://localhost:3900
S3_ACCESS_KEY_ID=huddle-access-key
S3_SECRET_ACCESS_KEY=huddle-secret-key
S3_REGION=garage
# Optional: serve stored assets directly from a CDN instead of proxying through /api/storage/
# NEXT_PUBLIC_CDN_BASE_URL=https://example.cloudfront.net

# KV (Redis) (optional)
# Defaults below are configured for the local Redis instance (see docker-compose.dev.yml)
KV_REST_API_URL=http://0.0.0.0:8079
KV_REST_API_TOKEN=dev_fake_token_123456789abcdefghijklmnop

# Toggle Self-Hosted mode
# Enable to remove the pay-wall and subscription billing functionality
NEXT_PUBLIC_SELF_HOSTED=false

# Stripe (cloud billing, optional). Without a key the pay wall shows built-in prices.
# STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint
# STRIPE_SIGNING_SECRET=

# Sign-in and registration
# Set to false to turn off email (OTP and password) login
# EMAIL_LOGIN_ENABLED=true
# Set to false to stop new accounts from being created
# REGISTRATION_ENABLED=true
# Comma separated list of emails allowed to register and log in (wildcards supported)
# ALLOWED_EMAILS=*@example.com
# Comma separated list of email domains that get banned automatically
# BANNED_DOMAINS=
# The account with this email may claim the instance admin role at /admin-setup
# INITIAL_ADMIN_EMAIL=

# Google sign-in, Google Calendar and Google Meet (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Set to false to keep the Google app for Calendar and Meet only
# GOOGLE_LOGIN_ENABLED=true

# Microsoft sign-in and Microsoft Teams (optional)
# MICROSOFT_TENANT_ID=common
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Set to false to keep the Microsoft registration for Teams only
# MICROSOFT_LOGIN_ENABLED=true

# Generic OpenID Connect sign-in (optional; the first three are required together)
# OIDC_DISCOVERY_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=OpenID Connect
# OIDC_EMAIL_CLAIM_PATH=email
# OIDC_NAME_CLAIM_PATH=name
# OIDC_PICTURE_CLAIM_PATH=picture
# Deprecated, no longer used
# OIDC_ISSUER_URL=

# Cloudflare Turnstile bot protection on sign-up (optional, set both or neither)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Conferencing integrations (optional). CONFERENCING_PROVIDERS lists the
# providers users can connect, as a comma separated list of google-meet, zoom,
# microsoft-teams and webex; each also needs its OAuth app below. Google Meet
# reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
# Microsoft Teams reuses MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET: the
# registration needs the delegated Microsoft Graph permission
# OnlineMeetings.ReadWrite and the redirect URI
# <base url>/api/integrations/callback/microsoft-teams. Teams connects through
# the `organizations` authority when MICROSOFT_TENANT_ID is common or
# consumers, and through the configured tenant otherwise.
# CONFERENCING_PROVIDERS=google-meet,zoom
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# Secret Token from the Zoom app's Features page; verifies deauthorization events.
# ZOOM_WEBHOOK_SECRET_TOKEN=
# Webex integration from developer.webex.com with the scopes
# meeting:schedules_write and spark:people_read and the redirect URI
# <base url>/api/integrations/callback/webex.
# WEBEX_CLIENT_ID=
# WEBEX_CLIENT_SECRET=

# Feature switches (optional)
# Calendar connections
# CALENDARS_ENABLED=false
# Scheduled events outside development
# SCHEDULED_EVENTS_ENABLED=false
# Guest poll creation on the cloud deployment
# QUICK_CREATE_ENABLED=false
# Cap open polls per organizer by tier (billing only)
# OPEN_POLL_LIMIT_ENABLED=false
# Run the queued email scheduler inside the server process
# EMAIL_QUEUE_SCHEDULER_ENABLED=true
# Rate limiting
# RATE_LIMIT_ENABLED=true
# Let webhooks target private network addresses (testing only)
# WEBHOOK_ALLOW_PRIVATE_URLS=false

# AI content moderation (optional)
# MODERATION_ENABLED=false
# OPENAI_API_KEY=

# White-label (optional)
# APP_NAME=Huddle
# PRIMARY_COLOR=#4f46e5
# PRIMARY_COLOR_DARK=#6366f1
# LOGO_URL=
# LOGO_URL_DARK=
# LOGO_ICON_URL=
# Hide attribution on invite pages and emails
# HIDE_ATTRIBUTION=false

# Maintenance mode: redirect pages to /maintenance and reject API requests
# MAINTENANCE_MODE=false
# Secret that bypasses maintenance mode via /maintenance?token=<secret> (16+ characters)
# MAINTENANCE_BYPASS_TOKEN=

# Bearer token required by the /api/house-keeping cron endpoints
# CRON_SECRET=

# Self-hosted licensing and the cloud API host (optional)
# LICENSE_API_URL=
# LICENSE_API_AUTH_TOKEN=
# API_BASE_URL=https://api.huddle.example

# Parent domain for cookies shared across subdomains, e.g. .huddle.example
# NEXT_PUBLIC_COOKIE_DOMAIN=
# Host that serves /_next/static (defaults to NEXT_PUBLIC_BASE_URL)
# NEXT_PUBLIC_ASSET_PREFIX=

# Outbound HTTP proxy for server-side requests (optional)
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=

# Logging level: trace, debug, info (default), warn, error, silent
# LOG_LEVEL=info

# Development and tooling (optional)
# Domain the dev server is reached on (set by `pnpm dev`)
# DEV_DOMAIN=web.huddle.localhost
# Hide the Next.js dev tools indicator
# HIDE_DEV_INDICATOR=false
# Open the bundle analyzer on build
# ANALYZE=false
# Skip env validation (builds and scripts that do not run the app)
# SKIP_ENV_VALIDATION=
# App version shown by /api/status (set by `pnpm build:web`)
# NEXT_PUBLIC_APP_VERSION=
# Port of the production server and base URL of the smoke test suite
# PORT=3000
# SMOKE_BASE_URL=http://localhost:3000
# Mailpit API used by the Playwright tests to read emails
# MAILPIT_API_URL=http://localhost:8025/api

# Set by the platform, not by you: NODE_ENV, NEXT_RUNTIME, NEXT_PHASE, CI,
# VERCEL, VERCEL_URL, VERCEL_BRANCH_URL
