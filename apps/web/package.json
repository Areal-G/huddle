{
  "name": "@huddle/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "portless run --name web.huddle sh -c 'NEXT_PUBLIC_BASE_URL=$PORTLESS_URL DEV_DOMAIN=${PORTLESS_URL#https://} pnpm exec next dev'",
    "build": "next build",
    "build:test": "NODE_ENV=test next build",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "type-check": "tsc --pretty --noEmit",
    "i18n:scan": "i18next-cli extract",
    "i18n:sync": "i18next-cli extract --sync-primary",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "test:integration": "playwright test",
    "test:unit": "vitest run",
    "test:codegen": "playwright codegen http://localhost:3000",
    "docker:start": "./scripts/docker-start.sh",
    "better-auth:generate": "pnpx @better-auth/cli@latest generate --config ./src/lib/auth.ts --output ../../packages/database/prisma/models/user.prisma"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.118",
