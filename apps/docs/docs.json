{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Huddle",
  "colors": {
    "primary": "#4f39f6",
    "light": "#F8FAFC",
    "dark": "#4f39f6"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["introduction", "faq"]
          },
          {
            "group": "How it Works",
            "pages": ["workflow/create", "workflow/invite", "workflow/schedule"]
          },
          {
            "group": "Spaces",
            "pages": [
              "spaces/introduction",
              "spaces/managing-seats",
              "spaces/members",
              "spaces/billing",
              "spaces/custom-branding"
            ]
          },
          {
            "group": "Guides",
            "pages": ["guide/participant-guide", "guide/content-moderation"]
          },
          {
            "group": "Contact",
            "pages": ["contact/support"]
          }
        ]
      },
      {
        "tab": "Self-Hosting",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "self-hosting/introduction",
              "self-hosting/installation/docker",
              "self-hosting/configuration",
              "self-hosting/single-sign-on",
              "self-hosting/management",
              "self-hosting/migration",
              "self-hosting/licensing",
              "self-hosting/white-labeling"
            ]
          },
          {
            "group": "Guides",
            "pages": ["self-hosting/control-panel"]
          },
          {
            "group": "Misc",
            "pages": ["self-hosting/managed-hosting"]
          }
        ]
      },
      {
        "tab": "Contribute",
        "groups": [
          {
            "group": "Contribute",
            "pages": ["contribute/introduction"]
          },
          {
            "group": "How to Contribute",
            "pages": [
              "contribute/donations",
              "contribute/translations",
              "contribute/documentation"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://huddle.dev"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#18181B"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Contact",
        "href": "https://support.huddle.dev/contact/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://github.com/areal/huddle"
    }
  },
  "footer": {
    "socials": {
      "twitter": "https://twitter.com/huddleco",
      "linkedin": "https://www.linkedin.com/company/huddle/",
      "github": "https://github.com/areal/huddle",
      "discord": "https://discord.com/invite/uzg4ZcHbuM",
      "website": "https://huddle.dev/"
    }
  },
  "redirects": [
    {
      "source": "/administrators/creating-a-meeting-poll",
      "destination": "/workflow/create"
    },
    {
      "source": "/administrators/sharing-a-meeting-poll",
      "destination": "/workflow/invite"
    },
    {
      "source": "/participants/submitting-a-response",
      "destination": "/guide/participant-guide"
    },
    {
      "source": "/participants/editing-a-response",
      "destination": "/guide/participant-guide"
    },
    {
      "source": "/self-hosting/pricing",
      "destination": "/self-hosting/licensing"
    },
    {
      "source": "/workflow/finalize",
      "destination": "/workflow/schedule"
    }
  ]
}
