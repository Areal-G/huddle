{
  "name": "@huddle/landing",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "portless run --name landing.huddle sh -c 'NEXT_PUBLIC_BASE_URL=$PORTLESS_URL DEV_DOMAIN=${PORTLESS_URL#https://} TAILWIND_MODE=watch pnpm exec next dev --turbopack'",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "type-check": "tsc --pretty --noEmit",
    "i18n:scan": "i18next-cli extract"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@huddle/billing": "workspace:*",
    "@huddle/database": "workspace:*",
    "@huddle/languages": "workspace:*",
    "@huddle/tailwind-config": "workspace:*",
    "@huddle/ui": "workspace:*",
    "@huddle/utils": "workspace:*",
    "@svgr/webpack": "^8.1.0",
    "dayjs": "^1.11.23",
    "gray-matter": "^4.0.3",
    "i18next": "^27.1.2",
    "i18next-icu": "^2.7.0",
    "i18next-resources-to-backend": "^1.2.4",
    "intl-messageformat": "^12.1.5",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "next-mdx-remote": "^6.0.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^18.0.1",
    "react-use": "^17.6.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.6",
    "@huddle/tsconfig": "workspace:*",
    "@types/js-cookie": "^3.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "^10.1.0",
    "i18next-cli": "^1.88.0"
  }
}
