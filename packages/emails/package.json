{
  "name": "@huddle/emails",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "email dev --dir ./src/templates",
    "type-check": "tsc --pretty --noEmit",
    "test:unit": "vitest run",
    "i18n:scan": "i18next-cli extract"
  },
  "exports": {
    ".": "./src/index.ts",
    "./templates/*": "./src/templates/*.tsx",
    "./locales/*": "./locales/en/*.json"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1169.0",
    "@aws-sdk/credential-provider-node": "^3.972.97",
    "@huddle/logger": "workspace:*",
    "@huddle/utils": "workspace:*",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "i18next": "^27.1.2",
    "i18next-icu": "^2.7.0",
    "i18next-resources-to-backend": "^1.2.4",
    "nodemailer": "^10.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^18.0.1"
  },
  "devDependencies": {
    "@huddle/tailwind-config": "workspace:*",
    "@huddle/tsconfig": "workspace:*",
    "@react-email/ui": "^6.11.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "i18next-cli": "^1.88.0",
    "jsdom": "^26.1.0",
    "react-email": "^6.11.13",
    "vitest": "^5.1.0"
  }
}
