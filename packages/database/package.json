{
  "name": "@huddle/database",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "db:generate": "prisma generate && tsx scripts/bundle-migrations.ts && tsx scripts/build-demo-snapshot.ts",
    "db:push": "prisma db push --skip-generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev --skip-generate",
    "db:reset": "prisma migrate reset && prisma db seed",
    "db:seed": "tsx prisma/seed.ts",
    "test:unit": "vitest run",
    "type-check": "tsc --pretty --noEmit"
  },
  "exports": {
    ".": "./src/client.ts",
    "./demo-account": "./src/demo-account.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/functions": "^3.11.3",
    "better-auth": "1.6.34",
    "pg": "^8.23.1",
    "pglite-prisma-adapter": "^0.7.2"
  },
  "devDependencies": {
    "@huddle/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
