# A connection string to your Postgres database
DATABASE_URL=postgres://postgres:postgres@localhost:5450/huddle
# Optional direct (non-pooled) connection for migrations when DATABASE_URL
# goes through a pooler; DATABASE_URL_UNPOOLED is the name some hosts use
# DIRECT_DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Sign-in for the owner of the sample workspace created by `npm run seed`
# SEED_OWNER_EMAIL=alex@example.com
# SEED_OWNER_PASSWORD=huddle-local-password

# The seed replaces all data, so it refuses to run with NODE_ENV=production
# NODE_ENV=development
